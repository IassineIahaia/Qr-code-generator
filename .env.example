# Modelo de configuração. Copie para .env.local e preencha com as chaves reais.
# NUNCA coloque valores reais neste arquivo — ele é versionado no git.

# Supabase — Project Settings > API
# URL do projeto, no formato https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Chave "anon public" (ou a "publishable", formato sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave "service_role": só no servidor, NUNCA exposta ao browser
SUPABASE_SERVICE_ROLE_KEY=

# Domínio usado nos links curtos dos QR Codes (sem barra no final)
NEXT_PUBLIC_SHORT_URL=http://localhost:3000

# Sal para o hash dos IPs registrados nos scans.
# Gere um valor aleatório: openssl rand -hex 32
SCAN_IP_SALT=

# Chave que assina o cookie de "já digitei a senha deste QR" (item 5.5).
# Trocá-la invalida os passes em circulação — quem estava dentro digita de novo.
# Sem valor aqui, o código cai na SUPABASE_SERVICE_ROLE_KEY; em produção, defina.
# Gere um valor aleatório: openssl rand -hex 32
APP_SECRET=
